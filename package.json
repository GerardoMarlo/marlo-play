{
  "name": "marlo-play",
  "private": true,
  "type": "module",
  "scripts": {
    "build:personal": "node build-personal.mjs",
    "test:personal": "node build-personal.mjs && node --test tests/personal.check.mjs",
    "deploy:personal": "npm run test:personal && npx wrangler deploy --config wrangler.personal.jsonc",
    "build": "node build.mjs",
    "test": "node build.mjs && node --test src/*.check.mjs",
    "deploy": "npm run build && npx wrangler deploy"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "sharp": "^0.35.4"
  }
}
